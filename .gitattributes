# Normalisation des fins de ligne : texte en LF dans le dépôt
* text=auto
*.py text eol=lf
*.pyw text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.cff text eol=lf

# Fichiers STEP : ne jamais modifier les fins de ligne ni fusionner en texte
*.stp -text
*.STP -text
*.step -text
*.STEP -text

# Si vos fichiers STEP dépassent 50 Mo, utilisez Git LFS (git lfs install), puis
# décommentez ces lignes AVANT d'ajouter les fichiers :
# *.stp filter=lfs diff=lfs merge=lfs -text
# *.step filter=lfs diff=lfs merge=lfs -text
